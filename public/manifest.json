{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://n8n.io/*",
        "https://*.n8n.io/*",
        "https://manus.ai/*",
        "https://*.manus.ai/*",
        "https://stitch.withgoogle.com/*",
        "https://*.stitch.withgoogle.com/*",
        "https://aistudio.google.com/*",
        "https://*.aistudio.google.com/*",
        "https://supabase.com/*",
        "https://*.supabase.com/*",
        "https://firebase.google.com/*",
        "https://*.firebase.google.com/*",
        "https://stripe.com/*",
        "https://*.stripe.com/*",
        "https://www.paypal.com/*",
        "https://paypal.com/*",
        "https://*.paypal.com/*",
        "https://www.tosspayments.com/*",
        "https://tosspayments.com/*",
        "https://*.tosspayments.com/*",
        "https://clerk.com/*",
        "https://*.clerk.com/*",
        "https://aws.amazon.com/*",
        "https://*.aws.amazon.com/*",
        "https://vercel.com/*",
        "https://*.vercel.com/*",
        "https://railway.app/*",
        "https://*.railway.app/*",
        "https://render.com/*",
        "https://*.render.com/*",
        "https://analytics.google.com/*",
        "https://*.analytics.google.com/*",
        "https://posthog.com/*",
        "https://*.posthog.com/*",
        "https://resend.com/*",
        "https://*.resend.com/*",
        "https://sentry.io/*",
        "https://*.sentry.io/*",
        "https://www.sanity.io/*",
        "https://sanity.io/*",
        "https://*.sanity.io/*",
        "https://strapi.io/*",
        "https://*.strapi.io/*",
        "https://github.com/*",
        "https://*.github.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "tabs", "activeTab", "sidePanel", "debugger"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://n8n.io/*",
    "https://*.n8n.io/*",
    "https://manus.ai/*",
    "https://*.manus.ai/*",
    "https://stitch.withgoogle.com/*",
    "https://*.stitch.withgoogle.com/*",
    "https://aistudio.google.com/*",
    "https://*.aistudio.google.com/*",
    "https://supabase.com/*",
    "https://*.supabase.com/*",
    "https://firebase.google.com/*",
    "https://*.firebase.google.com/*",
    "https://stripe.com/*",
    "https://*.stripe.com/*",
    "https://www.paypal.com/*",
    "https://paypal.com/*",
    "https://*.paypal.com/*",
    "https://www.tosspayments.com/*",
    "https://tosspayments.com/*",
    "https://*.tosspayments.com/*",
    "https://clerk.com/*",
    "https://*.clerk.com/*",
    "https://aws.amazon.com/*",
    "https://*.aws.amazon.com/*",
    "https://vercel.com/*",
    "https://*.vercel.com/*",
    "https://railway.app/*",
    "https://*.railway.app/*",
    "https://render.com/*",
    "https://*.render.com/*",
    "https://analytics.google.com/*",
    "https://*.analytics.google.com/*",
    "https://posthog.com/*",
    "https://*.posthog.com/*",
    "https://resend.com/*",
    "https://*.resend.com/*",
    "https://sentry.io/*",
    "https://*.sentry.io/*",
    "https://www.sanity.io/*",
    "https://sanity.io/*",
    "https://*.sanity.io/*",
    "https://strapi.io/*",
    "https://*.strapi.io/*",
    "https://github.com/*",
    "https://*.github.com/*",
    "https://vibe-guide-production.up.railway.app/*"
  ]
}
